{
  "name": "energon",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmchow/energon.git"
  },
  "bugs": {
    "url": "https://github.com/tmchow/energon/issues"
  },
  "homepage": "https://github.com/tmchow/energon#readme",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --config vitest.unit.config.ts && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "git config core.hooksPath .githooks || true && node scripts/vendor-mermaid.mjs",
    "vendor:mermaid": "node scripts/vendor-mermaid.mjs",
    "db:local": "wrangler d1 migrations apply energon --local",
    "db:remote": "wrangler d1 migrations apply energon --remote",
    "skill:render": "node scripts/render-skill.mjs",
    "skill:init": "node scripts/render-skill.mjs --init"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "marked": "^18.0.11",
    "mermaid": "11.17.2",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "undici": "7.29.0",
    "ws": "8.21.3"
  }
}
