{
  "name": "energon",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmchow/energon.git"
  },
  "bugs": {
    "url": "https://github.com/tmchow/energon/issues"
  },
  "homepage": "https://getenergon.com",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --config vitest.unit.config.ts && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run",
    "test:watch": "vitest",
    "fuzz:build": "esbuild fuzz/zip.ts --bundle --platform=node --format=esm --outfile=.fuzz-build/zip.mjs --external:@jazzer.js/core",
    "fuzz:regression": "npm run fuzz:build && jazzer .fuzz-build/zip.mjs --mode=regression --sync fuzz/corpus/zip",
    "fuzz:zip": "npm run fuzz:build && mkdir -p fuzz/artifacts/zip && jazzer .fuzz-build/zip.mjs --sync fuzz/corpus/zip -- -dict=fuzz/dicts/zip.dict -artifact_prefix=fuzz/artifacts/zip/",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && npm run check:ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "git config core.hooksPath .githooks || true && node scripts/vendor-mermaid.mjs",
    "vendor:mermaid": "node scripts/vendor-mermaid.mjs",
    "db:local": "wrangler d1 migrations apply energon --local",
    "db:remote": "wrangler d1 migrations apply energon --remote",
    "skill:render": "node scripts/render-skill.mjs",
    "skill:init": "node scripts/render-skill.mjs --init",
    "build:ui": "node scripts/build-ui.mjs",
    "check:ui": "npm run check --workspace @energon/svelte-tools",
    "specimen:ui": "node scripts/build-ui.mjs --specimen"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "marked": "^18.0.11",
    "mermaid": "11.17.2",
    "svelte": "5.57.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@jazzer.js/core": "^4.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "undici": "7.29.0",
    "ws": "8.21.3"
  },
  "workspaces": [
    "tooling/svelte"
  ]
}
